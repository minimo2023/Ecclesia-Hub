{
  "name": "ecclesia-hub",
  "private": true,
  "version": "5.0.138",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite \"Bible Millionaire Quiz\" --host",
    "dev:canonical": "node platform/serve-production-baseline.mjs",
    "dev:source": "vite \"Bible Millionaire Quiz\" --host",
    "dev:game": "vite \"Bible Millionaire Quiz\" --open /game.html",
    "server": "node \"Bible Millionaire Quiz/server/start.js\"",
    "server:watch": "nodemon --watch \"Bible Millionaire Quiz/server\" --ignore \"Bible Millionaire Quiz/server/tests/**\" --ignore \"Bible Millionaire Quiz/server/public/**\" --ignore \"Bible Millionaire Quiz/server/public-mobile/**\" --ext js,json --delay 200ms --exec node \"Bible Millionaire Quiz/server/start.js\"",
    "dev:mobile": "npm --prefix \"Bible Millionaire Quiz/mobile-app\" run dev",
    "dev:canonical:mobile": "cross-env BASELINE_PORT=5174 node platform/serve-production-baseline.mjs",
    "dev:source:mobile": "npm --prefix \"Bible Millionaire Quiz/mobile-app\" run dev",
    "dev:scripture-tools": "npm --prefix \"Bible Millionaire Quiz/scripture-tools-app\" run dev",
    "dev:production-baseline": "node platform/serve-production-baseline.mjs",
    "dev:xit": "node \"steward-ops/XIT-Worker/backend/standalone-server.mjs\"",
    "dev:all": "concurrently --kill-others \"npm run server:watch\" \"npm run dev\" \"npm run dev:scripture-tools\"",
    "build": "vite build \"Bible Millionaire Quiz\"",
    "build:mobile": "npm --prefix \"Bible Millionaire Quiz/mobile-app\" run build",
    "build:scripture-tools": "npm --prefix \"Bible Millionaire Quiz/scripture-tools-app\" run build",
    "preview:scripture-tools": "npm --prefix \"Bible Millionaire Quiz/scripture-tools-app\" run preview",
    "audit:scripture-order-seeds": "node \"Bible Millionaire Quiz/server/scripts/audit-scripture-order-seeds-deterministic.mjs\"",
    "audit:scripture-order-seeds:ai": "node \"Bible Millionaire Quiz/server/scripts/audit-scripture-order-seeds.mjs\"",
    "prepare:scripture-order-seeds": "node \"Bible Millionaire Quiz/server/scripts/audit-scripture-order-seeds.mjs\" --apply --candidate-only",
    "prepare:scripture-order-seeds:local": "node \"Bible Millionaire Quiz/server/scripts/prepare-scripture-segmentation-local.mjs\"",
    "cruise:scripture-segmentation:dry-run": "node \"Bible Millionaire Quiz/server/scripts/run-scripture-segmentation-cruise.mjs\"",
    "cruise:scripture-segmentation:activate": "node \"Bible Millionaire Quiz/server/scripts/run-scripture-segmentation-cruise.mjs\" --activate",
    "verify:scripture-segmentation": "node \"Bible Millionaire Quiz/server/scripts/verify-scripture-segmentation-cruise.mjs\"",
    "prepare:scripture-protected-terms:local": "node \"Bible Millionaire Quiz/server/scripts/extract-scripture-protected-terms-local.mjs\"",
    "build:all": "npm run build && npm run build:mobile && npm run build:scripture-tools",
    "test:xit": "npm --prefix \"steward-ops/XIT-Worker\" test",
    "test:bible": "node --test \"Bible Millionaire Quiz/server/tests/*.test.mjs\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high && npm --prefix \"Bible Millionaire Quiz/mobile-app\" audit --omit=dev --audit-level=high",
    "verify:structure": "node platform/verify-structure.mjs",
    "verify:production-baseline": "node platform/verify-production-baseline.mjs",
    "verify:production-baseline:strict": "cross-env VERIFY_CANONICAL_RUNTIME_TREE=true node platform/verify-production-baseline.mjs",
    "verify:developable-baseline": "node platform/verify-developable-baseline.mjs",
    "verify:xit-data": "node platform/verify-xit-data.mjs",
    "build:game": "vite build \"Bible Millionaire Quiz\" --outDir dist-game",
    "lint": "npm run lint:bible && npm run lint:mobile && npm run lint:scripture-tools",
    "lint:bible": "eslint --config \"Bible Millionaire Quiz/eslint.config.js\" \"Bible Millionaire Quiz/src\"",
    "lint:mobile": "npm --prefix \"Bible Millionaire Quiz/mobile-app\" run lint",
    "lint:scripture-tools": "eslint --config \"Bible Millionaire Quiz/eslint.config.js\" \"Bible Millionaire Quiz/scripture-tools-app\"",
    "check:node": "node platform/check-node-syntax.mjs",
    "check:utf8": "node platform/check-utf8.mjs",
    "verify:all": "npm run verify:structure && npm run check:utf8 && npm run check:node && npm run lint && npm run test:bible && npm run build:all && npm run test:xit && npm run verify:xit-data && npm run audit:prod",
    "preview": "vite preview \"Bible Millionaire Quiz\"",
    "preview:game": "vite preview \"Bible Millionaire Quiz\" --outDir dist-game",
    "preview:local": "npm run build && npm run server",
    "sync-from-prod": "node \"Bible Millionaire Quiz/scripts/sync-from-docker.js\"",
    "sync-to-prod": "node \"Bible Millionaire Quiz/scripts/sync-to-docker.js\"",
    "backup:now": "node -e \"import('./Bible Millionaire Quiz/server/infrastructure/dbBackup.js').then(m => m.backupAll('manual'))\"",
    "backup:list": "node -e \"import('./Bible Millionaire Quiz/server/infrastructure/dbBackup.js').then(m => console.log(JSON.stringify(m.listBackups(), null, 2)))\"",
    "backup:scripture-recordings": "node \"Bible Millionaire Quiz/server/scripts/backup-scripture-recordings.mjs\"",
    "verify:scripture-recording-restore": "node \"Bible Millionaire Quiz/server/scripts/verify-scripture-recording-restore.mjs\"",
    "db:check": "node -e \"import('./Bible Millionaire Quiz/server/database/healthCheck.js').then(m => m.checkAllDatabases())\"",
    "db:dev:up": "docker compose -f docker-compose.yml -f docker-compose.dev-db.yml up -d postgres",
    "db:dev:stop": "docker compose -f docker-compose.yml -f docker-compose.dev-db.yml stop postgres",
    "db:reconcile-assets": "node \"Bible Millionaire Quiz/server/scripts/reconcile-asset-ledger.mjs\"",
    "deploy:prod": "node \"Bible Millionaire Quiz/scripts/deploy_prod.js\"",
    "deploy:package": "node \"Bible Millionaire Quiz/scripts/deploy_prod.js\" --package-only",
    "rollback": "node \"Bible Millionaire Quiz/scripts/rollback.js\""
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@google/generative-ai": "^0.24.1",
    "archiver": "^7.0.1",
    "argon2": "^0.44.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "file-type": "^22.0.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^174.0.1",
    "heic-decode": "^2.1.0",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "music-metadata": "^11.15.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.4",
    "opencc-js": "^1.4.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "pinyin-pro": "^3.29.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4",
    "wait-on": "^9.0.5"
  }
}
