NODE_ENV=production
PORT=3000

# Keep the approved production desktop/mobile snapshots active. Change only
# after a reconciled frontend release has passed the production-baseline gate.
FRONTEND_DELIVERY_MODE=approved_snapshot

# AI providers (inject through the deployment secret store)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_PAID_KEYS=
GEMINI_FREE_KEYS=
GEMINI_WORKER_KEY=
GEMINI_MODELS=
DEVOTIONAL_AUTHOR_PROFILE_VERSION=v2
DEVOTIONAL_AUTHOR_V2_START_DATE=2026-08-16
GEMINI_API_VERSION=

# Authentication and signed game answers
JWT_SECRET=
ANSWER_TOKEN_SECRET=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
PUBLIC_APP_URL=https://example.com
SMTP_HOST=nisc.com.tw
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PostgreSQL
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Public frontend configuration (never place server secrets in VITE_* values)
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_SOCKET_PORT=

# Optional services
TUNNEL_TOKEN=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
QUESTION_REPLENISHMENT_ENABLED=false
PATROL_ENABLED=false
SCRIPTURE_TOOLS_ENABLED=false
# Enable both values when the formal Scripture Order game is approved for release.
SCRIPTURE_ORDER_ENABLED=false
VITE_SCRIPTURE_ORDER_ENABLED=false

# Per-minute AI request budgets
AI_RATE_LIMIT_IP_PER_MINUTE=20
AI_RATE_LIMIT_USER_PER_MINUTE=10
# 經文雨實驗遊戲：完成內部驗收前維持關閉
SCRIPTURE_RAIN_ENABLED=false
VITE_SCRIPTURE_RAIN_ENABLED=false
SCRIPTURE_RAIN_HINT_COST=5
# Enable in order after the production migration and media backup restore drill.
SCRIPTURE_TOOLS_ENABLED=true
SCRIPTURE_RECORDINGS_ENABLED=false
SCRIPTURE_COMMUNITY_ENABLED=false
SCRIPTURE_RECORDING_MEMBER_BYTES=524288000
