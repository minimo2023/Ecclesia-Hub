# Bible Millionaire Quiz - Environment Variables

# ============================================
# AI API Keys
# ============================================
# [主網站] Backend (Node.js) 題庫 AI 金鑰 - LogosEngine 使用
GEMINI_API_KEY=your_gemini_api_key_here

# [主網站] 多金鑰輪詢（逗號分隔），優先於 GEMINI_API_KEY
# GEMINI_API_KEYS=key1,key2,key3

# [前端] Vite 用戶端金鑰（如有需要）
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# [XIT-Worker 排班網站] 專用 AI 金鑰 - 完全獨立，不與主網站共用配額
# 若此欄位為空，排班 AI 功能會顯示友善錯誤，主網站完全不受影響
# 建議使用獨立帳號的 API Key，避免主站與排班的 AI 用量互相干擾
GEMINI_WORKER_KEY=your_worker_gemini_api_key_here

# ============================================
# Bible API Keys
# ============================================

# Biblia.com API Key
VITE_BIBLIA_API_KEY=

# API.Bible Key (如果有的話)
# VITE_API_BIBLE_KEY=your_api_bible_key_here

# Cache Configuration
# ============================================
# Backend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:3000

# Authentication (Google Client ID is public; SMTP credentials are server-only)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=nisc.com.tw
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Host-side development server connects to the Docker database through loopback.
# The bible-quiz container still overrides this value to the Compose service name "postgres".
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dev
DB_NAME=bible_quiz_v3

# Database
VITE_COLLECTION_PREFIX=

# ============================================
# Bible API Endpoints
# ============================================

# 信望愛聖經工具（免費）
VITE_FHL_API_BASE=https://bible.fhl.net/json/

# Bible-api.com（免費）
VITE_BIBLE_API_BASE=https://bible-api.com/

# Biblia.com
VITE_BIBLIA_API_BASE=https://api.biblia.com/v1/

# Feature Flags
VITE_FEATURE_AI_DEVOTIONAL=true
DEVOTIONAL_AUTHOR_PROFILE_VERSION=v2
DEVOTIONAL_AUTHOR_V2_START_DATE=2026-08-16
VITE_FEATURE_PHONE_FRIEND=true
SCRIPTURE_TOOLS_ENABLED=false
# Independent Scripture Order switch. Legacy *_LAB_* names remain accepted
# temporarily by the runtime, but new deployments should use these names.
SCRIPTURE_ORDER_ENABLED=false
VITE_SCRIPTURE_ORDER_ENABLED=false

# ============================================
# Cloudflare Tunnel Configuration
# ============================================
# 生產環境部署用 Token。本地開發請保持留空，否則會搶佔生產環境網址流量！
TUNNEL_TOKEN=
# 經文雨實驗遊戲：正式環境需明確開啟
SCRIPTURE_RAIN_ENABLED=false
VITE_SCRIPTURE_RAIN_ENABLED=false
SCRIPTURE_RAIN_HINT_COST=5
# Scripture Explorer recordings are independently switchable. Community only
# becomes active when recordings are enabled as well.
SCRIPTURE_TOOLS_ENABLED=true
SCRIPTURE_RECORDINGS_ENABLED=false
SCRIPTURE_COMMUNITY_ENABLED=false
SCRIPTURE_RECORDING_MEMBER_BYTES=524288000
SCRIPTURE_RECORDING_DAILY_SAVES=20
SCRIPTURE_RECORDING_DAILY_PUBLISHES=5
SCRIPTURE_RECORDING_DAILY_COMMENTS=30
SCRIPTURE_RECORDING_DAILY_REACTIONS=100
VITE_SCRIPTURE_EXPLORER_URL=
